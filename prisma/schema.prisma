generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now()) @db.Timestamptz
  sessions     Session[]
  bookings     Booking[]
}

enum Role {
  USER
  ADMIN
}

/// id = SHA-256 do token do cookie; o token em si nunca é salvo
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz

  @@index([userId])
}

model Experience {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  maxGuests   Int
  active      Boolean   @default(true)
  bookings    Booking[]
}

/// Salas físicas, compartilhadas por todas as experiências
model Room {
  id       String    @id
  number   Int       @unique
  name     String
  active   Boolean   @default(true)
  bookings Booking[]
}

/// Uma linha por dia aberto; dia sem linha = fechado
model OpeningHours {
  /// 0 = domingo … 6 = sábado
  weekday  Int @id
  /// minutos desde 00:00 (660 = 11:00)
  opensAt  Int
  closesAt Int
}

model Closure {
  date   DateTime @id @db.Date
  reason String?
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model Booking {
  id           String        @id @default(cuid())
  code         String        @unique
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceId String
  experience   Experience    @relation(fields: [experienceId], references: [id])
  roomId       String
  room         Room          @relation(fields: [roomId], references: [id])
  startsAt     DateTime      @db.Timestamptz
  endsAt       DateTime      @db.Timestamptz
  /// Total de pessoas: o titular + os acompanhantes
  guests       Int
  /// Nomes dos acompanhantes (o titular é o dono da conta); guests = 1 + companions.length
  companions   String[]      @default([])
  status       BookingStatus @default(CONFIRMED)
  createdAt    DateTime      @default(now()) @db.Timestamptz

  @@index([roomId, startsAt])
  @@index([userId, startsAt])
}
